@import "~/.config/rofi/colors.rasi"

configuration {
    show-icons:          true;
    font:                "JetBrainsMono Nerd Font 11";
    hover-select:        true;
    me-select-entry:     "MouseSecondary";
    me-accept-entry:     "MousePrimary";
    dpi:                 1;
}

* {
    background-alt:  @select-bg;
    selected:        rgba(255,255,255,0.16);
    active:          rgba(255,255,255,0.10);
    urgent:          rgba(255,80,80,0.28);
    text-color:      @main-fg;
    text-selected:   rgba(255,255,255,0.98);
    border-color:    @main-br;
}

window {
    enabled:          true;
    fullscreen:       false;
    transparency:     "real";
    cursor:           "default";
    location:         center;
    anchor:           center;
    width:            85%;
    spacing:          0px;
    border:           1px;
    border-radius: 14px;
    background-color: @main-bg;
    border-color:     @main-br;
}

mainbox {
    enabled:          true;
    children:         ["inputbar", "listview"];
    background-color: transparent;
}

inputbar {
    enabled:          true;
    padding:          14px 20px;
    margin:           20px 30px 10px 30px;
    border-radius:    10px;
    background-color: @select-bg;
    children:         ["prompt", "entry"];
}

prompt {
    enabled:          true;
    text-color:       @main-br;
    padding:          0px 8px 0px 0px;
    background-color: transparent;
    str:              "󰸉 ";
}

entry {
    enabled:          true;
    placeholder:      "Filter wallpapers...";
    placeholder-color:@main-fg;
    text-color:       @main-fg;
    background-color: transparent;
}

listview {
    enabled:          true;
    columns:          5;
    lines:            1;
    padding:          26px 36px;
    spacing:          20px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    background-color: transparent;
    border:           0px;
}

element {
    enabled:          true;
    orientation:      vertical;
    expand:           false;
    padding:          5px 10px;
    border-radius: 10px;
    cursor:           pointer;
    text-color:       @main-fg;
    background-color: rgba(255,255,255,0.06);
}

element normal.normal   { background-color: rgba(255,255,255,0.06); text-color: @main-fg; }
element normal.active   { background-color: rgba(255,255,255,0.10); text-color: @main-fg; }
element normal.urgent   { background-color: rgba(255,60,60,0.25);   text-color: @main-fg; }
element selected.normal { background-color: @main-br;               text-color: @main-bg; }
element alternate.normal{ background-color: rgba(255,255,255,0.05); text-color: @main-fg; }

element-icon {
    size:             25%;
    padding:          0px;
    background-color: transparent;
}

element-text {
    padding-left:     0px;
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
