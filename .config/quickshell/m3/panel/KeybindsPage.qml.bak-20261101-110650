import QtQuick
import QtQuick.Layouts
import qs.tokens
import qs.services
import qs.components

Page {
    id: page
    readonly property var filtered: {
        const q = search.text.toLowerCase().trim()
        if (q === "") return Keybinds.list
        return Keybinds.list.filter(b => (b.mods.join(" ") + " " + b.key + " " + b.desc).toLowerCase().includes(q))
    }
    onActiveChanged: if (active) { Keybinds.refresh(); Qt.callLater(() => search.forceActiveFocus()) }

    ColumnLayout {
        anchors.fill: parent
        spacing: 12

        Rectangle {
            Layout.fillWidth: true
            Layout.preferredHeight: 52
            radius: 26
            color: M3Colors.surfaceContainerHigh
            Icon { id: si; x: 16; anchors.verticalCenter: parent.verticalCenter; name: "search"; size: 22; color: M3Colors.fgSurfaceVariant }
            M3Text { visible: search.text === ""; x: 48; anchors.verticalCenter: parent.verticalCenter; text: "Search keybinds"; color: M3Colors.fgSurfaceVariant; role: M3Type.bodyLarge }
            TextInput {
                id: search
                anchors.left: si.right; anchors.leftMargin: 12
                anchors.right: count.left; anchors.rightMargin: 12
                anchors.verticalCenter: parent.verticalCenter
                color: M3Colors.fgSurface
                font.family: M3Type.family
                font.pixelSize: 16
                clip: true
                Keys.onEscapePressed: UiState.calendarOpen = false
            }
            M3Text { id: count; anchors.right: parent.right; anchors.rightMargin: 18; anchors.verticalCenter: parent.verticalCenter; text: page.filtered.length + " binds"; role: M3Type.labelMedium; color: M3Colors.fgSurfaceVariant }
        }

        M3Text { visible: Keybinds.list.length === 0; Layout.alignment: Qt.AlignHCenter; Layout.topMargin: 40; text: Keybinds.error !== "" ? Keybinds.error : "No keybindings found in m3.lua"; color: M3Colors.fgSurfaceVariant }

        ListView {
            id: list
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            spacing: 4
            boundsBehavior: Flickable.StopAtBounds
            model: page.filtered
            delegate: Rectangle {
                id: row
                required property var modelData
                required property int index
                width: list.width
                height: 48
                radius: 16
                color: "transparent"
                StateLayer { anchors.fill: parent; radius: parent.radius; hovered: rma.containsMouse }
                MouseArea { id: rma; anchors.fill: parent; hoverEnabled: true }
                RowLayout {
                    anchors.fill: parent
                    anchors.leftMargin: 12; anchors.rightMargin: 12
                    spacing: 6
                    Repeater {
                        model: row.modelData.mods.concat([row.modelData.key])
                        Rectangle {
                            required property string modelData
                            required property int index
                            readonly property bool isKey: index === row.modelData.mods.length
                            implicitWidth: kt.implicitWidth + 18
                            implicitHeight: 28
                            radius: 8
                            color: isKey ? M3Colors.primaryContainer : M3Colors.secondaryContainer
                            M3Text { id: kt; anchors.centerIn: parent; text: parent.modelData; role: M3Type.labelMedium; color: parent.isKey ? M3Colors.fgPrimaryContainer : M3Colors.fgSecondaryContainer }
                        }
                    }
                    M3Text {
                        Layout.fillWidth: true
                        Layout.leftMargin: 10
                        elide: Text.ElideRight
                        text: row.modelData.desc
                        role: M3Type.bodyMedium
                        color: M3Colors.fgSurfaceVariant
                    }

                    M3Button { 
                        contentItem: Row {
                            spacing: 6
                            anchors.centerIn: parent

                            Icon {
                                name: "play_arrow"
                                size: 20
                                color: M3Colors.fgSurface
                            }

                            M3Text {
                                text: "Run"
                                role: M3Type.labelLarge
                                color: M3Colors.fgSurface
                            }
                        }

variant: "tonal"
                        visible: row.modelData.run !== null && row.modelData.run !== undefined
                        enabled: visible
                        opacity: rma.containsMouse ? 1 : 0
                        Layout.preferredWidth: rma.containsMouse && visible ? 72 : 0
                        Layout.preferredHeight: 34
                        onClicked: Keybinds.run(row.modelData)

                        Behavior on opacity {
                            NumberAnimation { duration: 140 }
                        }
                    }
                }
            }
        }
    }
}
