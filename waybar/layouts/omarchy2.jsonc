{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 35,
    "margin-right": 0,
    "margin-left": 0,
    "margin-top": 0,
    "exclusive": true,

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "custom/active-window"
    ],

    "modules-center": ["custom/sep-blank"],

    "modules-right": [
        "tray",
        "group/mpris-expander",
        "custom/sep-blank",
        "group/right1",
        "clock"
    ],

    "group/right1": {
        "orientation": "inherit",
        "modules": [
            "custom/idle",
            "custom/notif",
            "pulseaudio",
            "bluetooth",
            "network",
            "battery"
        ]
    },

    "group/mpris-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 600,
            "children-class": "mpris-group-item"
        },
        "modules": ["custom/expand-mpris", "mpris"]
    },

    "custom/expand-mpris": {
        "format": "󰃂",
        "tooltip": false
    },

    "mpris": {
        "interval": 2,
        "format": " {dynamic}",
        "format-paused": " {artist} - {title}",
        "on-click-middle": "playerctl play-pause",
        "on-click": "playerctl previous",
        "on-click-right": "playerctl next",
        "scroll-step": 5.0,
        "smooth-scrolling-threshold": 1,
        "tooltip": true,
        "tooltip-format": "{status_icon} {dynamic}\nLeft: previous  Mid: pause  Right: next",
        "player-icons": {
            "chromium": "",
            "default":  "",
            "firefox":  "",
            "mpv":      "󰐹",
            "spotify":  "󰎆",
            "vlc":      "󰕼"
        },
        "status-icons": {
            "paused":  "",
            "playing": "",
            "stopped": ""
        },
        "dynamic-order": ["artist", "title"],
        "ignored-players": ["firefox"],
        "max-length": 28
    },

    "custom/arch": {
        "format": "<span size='11500'>󰣇</span>",
        "on-click": "rofi -show drun -theme ~/.config/rofi/config.rasi -show-icons -icon-theme Papirus-Dark",
        "on-click-right": "kitty",
        "tooltip-format": "App Launcher\n\nALT + D"
    },

    "custom/active-window": {
        "exec": "bash ~/.config/waybar/scripts/window.sh",
        "return-type": "json",
        "interval": 1,
        "markup": true
    },

    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{name}",
        "persistent-workspaces": {
            "1": [], "2": [], "3": [],
            "4": [], "5": []
        }
    },

    "clock": {
        "format": " {:%I:%M %p}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "network": {
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "<span size='11500'>󰌘</span>",
        "format-disconnected": "<span size='11500'>󰤮</span>",
        "tooltip-format-wifi": "{essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": ["󰢜","󰂆","󰂇","󰂈","󰢝","󰂉","󰢞","󰂊","󰂋","󰂅"],
            "default":  ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "interval": 5,
        "states": { "warning": 20, "critical": 10 }
    },

    "bluetooth": {
        "format": "<span size='11500'>󰂯</span>",
        "format-disabled": "<span size='11500'>󰂲</span>",
        "format-connected": "<span size='11500'></span>",
        "format-no-controller": "",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "<span size='11500'>{icon}</span>",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Volume: {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": { "default": [" "," "," "] },
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "tray": { "icon-size": 16, "spacing": 8 },

    "custom/sep-blank": { "format": " ", "interval": "once", "tooltip": false },
    "custom/sep-dot":   { "format": "·", "interval": "once", "tooltip": false },

    "custom/idle": {
        "exec": "bash ~/.config/waybar/scripts/idle-indicator.sh",
        "interval": 5,
        "return-type": "json",
        "on-click": "if pgrep hypridle > /dev/null; then pkill hypridle; else hypridle &; fi"
    },

    "custom/notif": {
        "exec": "bash ~/.config/waybar/scripts/notif-indicator.sh",
        "interval": 3,
        "return-type": "json",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    }
}
