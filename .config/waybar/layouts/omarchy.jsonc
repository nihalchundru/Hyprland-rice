{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 35,
    "margin-right": 10,
    "margin-left": 10,
    "margin-top": 6,
    "exclusive": true,

    "modules-left":   ["custom/arch", "custom/active-window"],
    "modules-center": ["group/center-stats", "hyprland/workspaces", "group/center-info"],
    "modules-right":  ["group/right"],

    "group/center-stats": {
        "orientation": "inherit",
        "modules": ["cpu", "memory", "custom/sep-blank", "custom/media"]
    },

    "group/center-info": {
        "orientation": "inherit",
        "modules": ["clock", "custom/notif", "custom/idle"]
    },

    "group/right": {
        "orientation": "inherit",
        "modules": [
            "tray",
            "custom/sep-blank",
            "custom/sep-dot",
            "custom/sep-blank",
            "pulseaudio",
            "bluetooth",
            "network",
            "battery"
        ]
    },

    "custom/arch": {
        "format": "<span size='12500'>󰣇</span>",
        "on-click": "rofi -show drun -theme ~/.config/rofi/config.rasi -show-icons -icon-theme Papirus-Dark",
        "on-click-right": "kitty",
        "tooltip-format": "App Launcher\n\nALT + D"
    },

    "custom/active-window": {
        "exec": "bash ~/.config/waybar/scripts/window.sh",
        "return-type": "json",
        "interval": 1,
        "markup": true
    },

    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{name}",
        "format-icons": {
            "default": "",
            "active":  "",
            "urgent":  "",
            "empty":   ""
        },
        "persistent-workspaces": {
            "1": [], "2": [], "3": [],
            "4": [], "5": []
        }
    },

    "cpu": {
        "interval": 2,
        "format": "{icon} ",
        "format-icons": ["󰪞","󰪟","󰪠","󰪡","󰪢","󰪣","󰪤","󰪥"],
        "on-click": "kitty -e btop",
        "tooltip": false
    },

    "memory": {
        "interval": 2,
        "format": "{icon} ",
        "format-icons": ["󰪞","󰪟","󰪠","󰪡","󰪢","󰪣","󰪤","󰪥"],
        "on-click": "kitty -e btop",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "custom/media": {
        "exec": "title=$(playerctl metadata title 2>/dev/null); if [ -n \"$title\" ]; then echo \"  ${title:0:25} \"; else echo \"  No media \"; fi",
        "interval": 2,
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "clock": {
        "format": " {:%I:%M %p • %a, %d/%m}     ",
        "format-alt": "{:%A, %d %B %Y}   ",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/notif": {
        "exec": "bash ~/.config/waybar/scripts/notif-indicator.sh",
        "interval": 3,
        "return-type": "json",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },

    "custom/idle": {
        "exec": "bash ~/.config/waybar/scripts/idle-indicator.sh",
        "interval": 5,
        "return-type": "json",
        "on-click": "if pgrep hypridle > /dev/null; then pkill hypridle; else hypridle &; fi"
    },

    "network": {
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "<span size='11500'>󰌘</span>",
        "format-disconnected": "<span size='11500'>󰤮</span>",
        "tooltip-format-wifi": "{essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": ["󰢜","󰂆","󰂇","󰂈","󰢝","󰂉","󰢞","󰂊","󰂋","󰂅"],
            "default":  ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "interval": 5,
        "states": { "warning": 20, "critical": 10 }
    },

    "bluetooth": {
        "format": "<span size='11500'>󰂯</span>",
        "format-disabled": "<span size='11500'>󰂲</span>",
        "format-connected": "<span size='11500'></span>",
        "format-no-controller": "",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "<span size='11500'>{icon}</span>",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Volume: {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "default": [" "," "," "]
        },
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/sep-blank": {
        "format": " ",
        "interval": "once",
        "tooltip": false
    },

    "custom/sep-dot": {
        "format": "·",
        "interval": "once",
        "tooltip": false
    }
}
