{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 8,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "exclusive": false,
    "reload_style_on_change": true,
    "modules-left":   [],
    "modules-center": ["clock", "mpris"],
    "modules-right":  [],
    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃮 {:%a %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "mpris": {
        "format": " {title}",
        "format-paused": "⏸ {title}",
        "format-stopped": "",
        "max-length": 22,
        "interval": 1,
        "tooltip": false
    }
}
