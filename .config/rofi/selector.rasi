/**
 * HyDE Global Selector Style — adapted for rofi-git ARM
 * @theme replaced with @import for rofi-git compatibility
 * dynamic: true for dmenu input compatibility
 */

configuration {
    modi:                "drun";
    show-icons:          true;
    drun-display-format: "{name}";
    font:                "JetBrainsMono Nerd Font 10";
}

@import "~/.config/rofi/theme.rasi"

window {
    enabled:             true;
    width: 80%;
    fullscreen:          false;
    transparency:        "real";
    cursor:              "default";
    spacing:             0em;
    padding:             0em;
    border:              0em;
    border-radius:       5em;
    border-color:        transparent;
    background-color:    rgba(40, 44, 52, 35%);
}

mainbox {
    enabled:             true;
    orientation:         horizontal;
    children:            ["dummy", "frame", "dummy"];
    background-color:    transparent;
}

frame {
    children:            ["listview"];
    background-color:    transparent;
}

listview {
    enabled:             true;
    spacing:             3em;
    padding:             3em;
    columns:             2;
    lines:               1;
    dynamic:             true;
    fixed-height:        false;
    fixed-columns:       true;
    reverse:             false;
    cursor:              "default";
    background-color:    transparent;
    text-color:          @main-fg;
}

dummy {
    width:               2em;
    expand:              false;
    background-color:    transparent;
}

element {
    enabled:             true;
    spacing:             0em;
    padding:             2em 2em;
    cursor:              pointer;
    background-color:    transparent;
    text-color:          @main-fg;
    orientation:         vertical;
    border-radius: 1em;
}

element normal normal {
    background-color:    transparent;
    text-color:          @main-fg;
}

element selected normal {
    background-color:    @select-bg;
    text-color:          @select-fg;
    border-radius: 5em;
}

element-icon {
    cursor:              inherit;
    size:                18em;
    background-color:    transparent;
    text-color:          inherit;
    expand:              false;
}

element-text {
    vertical-align:      0.5;
    horizontal-align:    0.5;
    cursor:              inherit;
    background-color:    transparent;
    text-color:          inherit;
}
