import QtQuick
import Quickshell
import Quickshell.Wayland
import qs.tokens
import qs.services
import qs.components

// Manage widgets in the sidebar (Widgets tab). Drag to move; a grid shows while dragging.
PanelWindow {
    id: win
    screen: Quickshell.screens[0]
    WlrLayershell.namespace: "m3-widgets"
    WlrLayershell.layer: WlrLayer.Bottom
    exclusionMode: ExclusionMode.Ignore
    anchors { top: true; bottom: true; left: true; right: true }
    color: "transparent"
    visible: M3Config.widgetsEnabled

    // click empty desktop while editing -> deselect
    MouseArea { anchors.fill: parent; onClicked: if (UiState.sidebarOpen && UiState.sidebarTab === 1) Widgets.selectedId = "" }

    Canvas {
        id: grid
        anchors.fill: parent
        readonly property int g: Math.max(4, M3Config.widgetGrid)
        opacity: Widgets.dragId !== "" && M3Config.widgetShowGrid ? 1 : 0
        visible: opacity > 0.01
        FadeBehavior on opacity { time: M3Motion.short4 }
        onGChanged: requestPaint()
        onWidthChanged: requestPaint()
        onHeightChanged: requestPaint()
        onVisibleChanged: if (visible) requestPaint()
        onPaint: {
            const ctx = getContext("2d")
            ctx.reset()
            // Minor grid lines
            ctx.beginPath()
            ctx.strokeStyle = Qt.alpha(M3Colors.primary, 0.38)
            ctx.lineWidth = 1
            for (let x = 0; x <= width; x += g) {
                if (x % (g * 5) === 0) continue
                ctx.moveTo(x + 0.5, 0)
                ctx.lineTo(x + 0.5, height)
            }
            for (let y = 0; y <= height; y += g) {
                if (y % (g * 5) === 0) continue
                ctx.moveTo(0, y + 0.5)
                ctx.lineTo(width, y + 0.5)
            }
            ctx.stroke()

            // Major grid lines
            ctx.beginPath()
            ctx.strokeStyle = Qt.alpha(M3Colors.primary, 0.72)
            ctx.lineWidth = 1.5
            const major = g * 5
            for (let x = 0; x <= width; x += major) {
                ctx.moveTo(x + 0.5, 0)
                ctx.lineTo(x + 0.5, height)
            }
            for (let y = 0; y <= height; y += major) {
                ctx.moveTo(0, y + 0.5)
                ctx.lineTo(width, y + 0.5)
            }
            ctx.stroke()
        }
        Rectangle {
            // Landing preview follows the same snap strength as the drop.
            visible: M3Config.widgetSnap && Widgets.dragId !== ""

            x: Math.max(0, Math.min(
                Widgets.dragRect.x +
                (Math.round(Widgets.dragRect.x / grid.g) * grid.g - Widgets.dragRect.x) *
                Math.max(0, Math.min(100, M3Config.widgetSnapStrength)) / 100,
                grid.width - width
            ))

            y: Math.max(0, Math.min(
                Widgets.dragRect.y +
                (Math.round(Widgets.dragRect.y / grid.g) * grid.g - Widgets.dragRect.y) *
                Math.max(0, Math.min(100, M3Config.widgetSnapStrength)) / 100,
                grid.height - height
            ))

            width: Widgets.dragRect.width
            height: Widgets.dragRect.height
            radius: 28
            color: Qt.alpha(M3Colors.primary, 0.24)
            border.width: 3
            border.color: M3Colors.primary

            Rectangle {
                anchors.fill: parent
                anchors.margins: 5
                radius: 23
                color: Qt.alpha(M3Colors.primary, 0.10)
                border.width: 1
                border.color: Qt.alpha(M3Colors.primary, 0.65)
            }
        }
    }

    Repeater {
        model: Widgets.ids
        WidgetFrame {
            id: fr
            required property string modelData
            wid: modelData
            width: fr.inst && fr.inst.type === "visualizer" && fr.inst.fullWidth
                ? Math.max(0, win.width - 48)
                : holder.childrenRect.width
            x: fr.inst && fr.inst.type === "visualizer" && fr.inst.fullWidth
                ? 24
                : undefined
            Loader {
                id: ld
                source: fr.inst ? Widgets.tileFile(fr.inst.type) + ".qml" : ""
                width: fr.inst ? Widgets.widgetDims(fr.inst)[0] : 0
                height: fr.inst ? Widgets.widgetDims(fr.inst)[1] : 0
                Binding { target: ld.item; property: "cfg"; value: fr.inst; when: ld.item !== null }
            }
        }
    }
}
