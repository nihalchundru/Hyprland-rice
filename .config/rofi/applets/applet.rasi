@import "~/.config/rofi/theme.rasi"

configuration {
    show-icons: false;
}

* {
    background:     @main-bg;
    foreground:     @main-fg;
    background-alt: @select-bg;
    selected:       @main-br;
    active:         @main-br;
    urgent:         @select-bg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            480px;
    border:           0px solid;
    border-radius:    16px;
    border-color:     @selected;
    background-color: @background;
}

mainbox {
    enabled:          true;
    spacing:          12px;
    margin:           0px;
    padding:          24px;
    background-color: transparent;
    children:         ["listview"];
}

listview {
    enabled:          true;
    columns:          4;
    lines:            1;
    cycle:            true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          12px;
    background-color: transparent;
    cursor:           "default";
}

element {
    enabled:          true;
    padding:          24px 10px;
    border:           0px solid;
    border-radius:    12px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    font:             "JetBrainsMono Nerd Font 28";
}

element normal.normal,
element alternate.normal {
    background-color: @background-alt;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color:       @background;
}
