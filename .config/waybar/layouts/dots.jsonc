{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 6,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right":  ["pulseaudio", "network", "battery", "custom/swaync", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "•",
            "2": "•",
            "3": "•",
            "4": "•",
            "5": "•",
            "empty": "◦",
            "active": "●",
            "default": "◦"
        },
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": { "*": [1,2,3,4,5] },
        "tooltip": false
    },

    "hyprland/window": {
        "format": " {title}",
        "max-length": 30,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*)kitty": "",
            "(.*)Thunar": "󰝰"
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿","󰖀","󰕾"] },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip-format": "Volume: {volume}%"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} {signalStrength}%",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-icons": ["󰂎","󰁺","󰁾","󰂁","󰁹"],
        "tooltip-format": "{capacity}% — {timeTo}"
    },

    "custom/swaync": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": { "none": "󰂚", "notification": "󰂚", "dnd-none": "󰂛", "dnd-notification": "󰂛" },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "bash ~/.config/hypr/scripts/powermenu.sh"
    }
}
