{
    "layer": "top",
    "position": "top",
    "spacing": 18,
    "margin-top": 10,
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-center": [
        "clock",
        "hyprland/workspaces",
        "pulseaudio",
        "network",
        "battery",
	"custom/hyde-menu"
    ],

    "clock": {
        "interval": 60,
        "format": "{:%I:%M %p}",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": { "*": 5 }
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%) 󰤨",
        "format-ethernet": "{ipaddr} 󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) 󰤨",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 20
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁾", "󰂁", "󰁹"]
    },

    "custom/hyde-menu": {
        "format": "󱗼",
        "tooltip": false,
        "on-click": "bash ~/.config/hypr/scripts/launcher.sh",
        "on-click-right": "bash ~/.config/hypr/scripts/powermenu.sh"
    }
}
