/* ML4W Launcher — fixed double wallpaper + circular mode buttons */

configuration {
    modi:                "drun,filebrowser,window,run";
    show-icons:          true;
    icon-theme:         "Fluent";
    display-drun:        "";
    display-run:         "";
    display-filebrowser: "󰉓";
    display-window:      "";
    drun-display-format: "{name}";
    hover-select:        false;
    scroll-method:       1;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    window-format:       "{w} · {c} · {t}";
}

@theme "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/current_wallpaper.rasi"

window {
    height:           26em;
    width:            42em;
    transparency:     "real";
    fullscreen:       false;
    cursor:           "default";
    spacing:          0em;
    padding:          0em;
    border:           2px;
    border-color:     @primary;
    border-radius: 14px;
    background-color: @background;
}

/* NO background-image here — only on imagebox */
mainbox {
    spacing:          0em;
    padding:          0em;
    orientation:      horizontal;
    children:         ["imagebox", "listbox"];
    background-color: transparent;
}

/* Left panel — wallpaper ONLY here */
imagebox {
    padding:          0em;
    width:            13em;
    orientation:      vertical;
    children:         ["inputbar", "dummy", "mode-switcher"];
    background-image: @current-image;
    background-color: @surface;
    border-radius:    12px 0px 0px 12px;
}

dummy {
    background-color: transparent;
    expand:           true;
}

/* Circular buttons at bottom of wallpaper panel */
mode-switcher {
    orientation:      horizontal;
    padding:          12px;
    spacing:          10px;
    border-radius:    0px 0px 0px 12px;
    expand:           false;
}

/* Each button is a circle */
button {
    padding:          0px;
    width:            36px;
    height:           36px;
    border-radius: 18px;
    cursor:           pointer;
    text-color:       @on-surface;
    font:             "JetBrainsMono Nerd Font 16";
    expand:           false;
}

button selected {
    background-color: @primary;
    text-color:       @on-primary;
    border-radius:    18px;
}

inputbar {
    margin:           12px 12px 0px 12px;
    children:         ["textbox-prompt-colon", "entry"];
    border-radius:    10px;
}

textbox-prompt-colon {
    expand:           false;
    str:              "  ";
    padding:          0.8em 0.3em 0em 0.5em;
    text-color:       @primary;
    background-color: transparent;
}

entry {
    spacing:          0.5em;
    padding:          0.8em 0.8em 0.8em 0em;
    text-color:       @on-surface;
    cursor:           text;
    placeholder:      "Search apps...";
    background-color: transparent;
    placeholder-color: @on-surface-variant;
}

/* Right panel */
listbox {
    padding:          0em;
    orientation:      vertical;
    children:         ["listview"];
    background-color: @background;
    border-radius:    0px 12px 12px 0px;
}

listview {
    padding:          1em;
    spacing:          0.3em;
    columns:          1;
    lines:            6;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    cursor:           "default";
    background-color: transparent;
    text-color:       @on-surface;
}

element {
    spacing:          10px;
    padding:          0.5em 0.8em;
    cursor:           pointer;
    background-color: transparent;
    text-color:       @on-surface;
    border-radius: 10px;
}

element normal normal    { background-color: transparent; text-color: @on-surface; }
element selected normal  { background-color: @surface;    text-color: @on-surface; border-radius: 10px; }
element alternate normal { background-color: transparent; text-color: @on-surface; }

element-icon {
    size:             2.2em;
    background-color: transparent;
    text-color:       inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
