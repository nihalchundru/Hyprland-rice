{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "color": {
            "1": "blue",
            "2": "cyan"
        },
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys":  "cyan",
            "title": "blue"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "break",
        {
            "type": "os",
            "key":      "󰣇 OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key":      " Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key":      "󰔛 Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key":      "󰏖 Packages",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key":      " Shell",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key":      " Terminal",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "wm",
            "key":      "󱂬 WM",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key":      "󰟡 Theme",
            "keyColor": "blue",
            "text": "cat ~/.config/hypr/themes/current-name 2>/dev/null || echo catppuccin"
        },
        {
            "type": "command",
            "key":      " Bar",
            "keyColor": "blue",
            "text": "cat ~/.config/hypr/bar/active-bar 2>/dev/null || echo waybar"
        },
        {
            "type": "command",
            "key":      "󰿬 Layout",
            "keyColor": "blue",
            "text": "cat ~/.config/waybar/current-layout 2>/dev/null || echo hyde-default"
        },
        {
            "type": "command",
            "key":      " Launcher",
            "keyColor": "blue",
            "text": "cat ~/.config/rofi/current-layout 2>/dev/null || echo ml4w"
        },
        {
            "type": "command",
            "key":      "󰸉 Transition",
            "keyColor": "blue",
            "text": "printf '%s (%ss)' \"$(cat ~/.config/hypr/themes/wall-transition 2>/dev/null || echo grow)\" \"$(cat ~/.config/hypr/themes/wall-transition-duration 2>/dev/null || echo 1.8)\""
        },
        {
            "type": "command",
            "key":      "󰛨 Night Shift",
            "keyColor": "blue",
            "text": "cat ~/.config/hypr/themes/night-shift-state 2>/dev/null || echo off"
        },
        "break",
        {
            "type": "cpu",
            "key":      "󰻠 CPU",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key":      "󰍛 RAM",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key":      "󰋊 Disk",
            "keyColor": "yellow",
            "folders": "/"
        },
        {
            "type": "display",
            "key":      "󰍹 Display",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 0,
            "symbol": "circle"
        }
    ]
}
