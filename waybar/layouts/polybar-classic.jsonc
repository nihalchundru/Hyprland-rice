{
    "layer": "top",
    "position": "top",
    "height": 26,
    "margin": 0,
    "spacing": 0,
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
        "mpris",
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "clock",
        "custom/power"
    ],

    "custom/arch": {
        "format": "󱗼 ",
        "tooltip": false,
        "on-click": "bash ~/.config/hypr/scripts/launcher.sh"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": { "*": [1,2,3,4,5] },
        "tooltip": false
    },

    "hyprland/window": {
        "format": "  {}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "(.*)kitty": "  terminal",
            "(.*)Thunar": "  files",
            "(.*)Firefox": "  firefox"
        }
    },

    "mpris": {
        "format": " {title}",
        "format-paused": " {title}",
        "format-stopped": "",
        "max-length": 24,
        "interval": 1,
        "tooltip": false
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2,
        "tooltip": false,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "   {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "   wired",
        "format-disconnected": "  offline",
        "max-length": 16,
        "tooltip-format-wifi": "{essid} {signalStrength}%",
        "on-click": "nm-connection-editor",
        "interval": 3
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": { "default": ["󰖁","",""] },
        "on-click": "pavucontrol",
        "on-scroll-up": "bash ~/.config/hypr/scripts/volume.sh --inc",
        "on-scroll-down": "bash ~/.config/hypr/scripts/volume.sh --dec",
        "tooltip": false
    },

    "clock": {
        "format": "   {:%I:%M %p}",
        "format-alt": "  {:%a %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "custom/power": {
        "format": "⏻ ",
        "tooltip": false,
        "on-click": "bash ~/.config/hypr/scripts/powermenu.sh"
    }
}
