{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,

    "modules-left":   ["group/leaf-left"],
    "modules-center": ["group/pill-left", "group/pill-center", "group/pill-right"],
    "modules-right":  ["group/leaf-right"],

    "group/leaf-left": {
        "orientation": "inherit",
        "css-class": "leaf",
        "modules": ["hyprland/workspaces", "hyprland/window"]
    },

    "group/pill-left": {
        "orientation": "inherit",
        "css-class": "pill",
        "modules": ["custom/weather"]
    },

    "group/pill-center": {
        "orientation": "inherit",
        "css-class": "pill",
        "modules": ["clock", "mpris"]
    },

    "group/pill-right": {
        "orientation": "inherit",
        "css-class": "pill",
        "modules": ["idle_inhibitor", "keyboard-state"]
    },

    "group/leaf-right": {
        "orientation": "inherit",
        "css-class": "leaf",
        "modules": [
            "tray",
            "network",
            "pulseaudio",
            "pulseaudio#microphone",
            "battery",
            "cpu",
            "memory",
            "custom/swaync",
            "custom/hyde-menu"
        ]
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": { "*": [1,2,3,4,5] },
        "tooltip": false
    },

    "hyprland/window": {
        "format": "  {}",
        "max-length": 35,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*)Thunar": "󰝰 Files",
            "(.*)kitty": " Terminal",
            "(.*)btop": "󰊚 System"
        }
    },

    "clock": {
        "format": "󰥔 {:%I:%M %p}",
        "format-alt": "󰃮 {:%a %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "today": "<span color='#CBA6F7'><b><u>{}</u></b></span>"
            }
        }
    },

    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": "󰏤 {title}",
        "format-stopped": "",
        "player-icons": { "default": "▶", "firefox": "󰈹", "mpv": "󰝚" },
        "max-length": 24,
        "interval": 1,
        "tooltip-format": "🎵 {title}\n👤 {artist}"
    },

    "custom/weather": {
        "exec": "curl -sf 'wttr.in/?format=%c+%t' 2>/dev/null || echo '? --'",
        "interval": 1800,
        "format": "{}",
        "tooltip": false
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰒳", "deactivated": "󰒲" },
        "tooltip-format-activated": "Idle inhibitor ON",
        "tooltip-format-deactivated": "Idle inhibitor OFF"
    },

    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰤭",
        "max-length": 14,
        "tooltip-format-wifi": "{essid}\n{ipaddr}\n↓{bandwidthDownBits} ↑{bandwidthUpBits}",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿","󰖀","󰕾"] },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip-format": "Volume: {volume}%"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰂎","󰁺","󰁾","󰂁","󰁹"],
        "tooltip-format": "{capacity}%\n{timeTo}"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop",
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "tray": {
        "spacing": 6,
        "icon-size": 15
    },

    "custom/swaync": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "none": "󰂚",
            "notification": "󰂚",
            "dnd-none": "󰂛",
            "dnd-notification": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/hyde-menu": {
        "format": "󱗼",
        "tooltip": false,
        "on-click": "bash ~/.config/hypr/scripts/launcher.sh",
        "on-click-right": "bash ~/.config/hypr/scripts/powermenu.sh"
    }
}
